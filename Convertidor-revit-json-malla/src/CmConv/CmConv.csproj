<Project Sdk="Microsoft.NET.Sdk">

  <!-- Converts a Revit .rvt (2023–2027) into Cmcoordinator's live-model packages (protocol 3) without Revit.
       The packaging and IFC rules are Cmcoordinator's own sources, linked rather than copied. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>cmconv</AssemblyName>
    <RootNamespace>CmConv</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <CmcoordinatorLiveSync>..\..\..\src\OpenProject.Revit\LiveSync</CmcoordinatorLiveSync>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(CmcoordinatorLiveSync)\LiveContracts.cs" Link="Cmcoordinator\LiveContracts.cs" />
    <Compile Include="$(CmcoordinatorLiveSync)\Bim\BimContracts.cs" Link="Cmcoordinator\BimContracts.cs" />
    <Compile Include="$(CmcoordinatorLiveSync)\Bim\DirectIfcSemantics.cs" Link="Cmcoordinator\DirectIfcSemantics.cs" />
    <Compile Include="$(CmcoordinatorLiveSync)\Queue\PartCompactor.cs" Link="Cmcoordinator\PartCompactor.cs" />
    <Compile Include="$(CmcoordinatorLiveSync)\Queue\SqliteOutbox.cs" Link="Cmcoordinator\SqliteOutbox.cs" />
    <Compile Include="$(CmcoordinatorLiveSync)\Queue\SyncModels.cs" Link="Cmcoordinator\SyncModels.cs" />
    <Compile Include="$(CmcoordinatorLiveSync)\Capture\CaptureLimits.cs" Link="Cmcoordinator\CaptureLimits.cs" />
    <Compile Include="$(CmcoordinatorLiveSync)\Drawings\DrawingContracts.cs" Link="Cmcoordinator\DrawingContracts.cs" />
    <Compile Include="$(CmcoordinatorLiveSync)\NetCompat.cs" Link="Cmcoordinator\NetCompat.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.18" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Datos\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
