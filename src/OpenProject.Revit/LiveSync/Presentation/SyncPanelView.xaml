<UserControl x:Class="OpenProject.Revit.LiveSync.Presentation.SyncPanelView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenProject.Revit.LiveSync.Presentation" MinWidth="280" FontFamily="Segoe UI" FontSize="14"
 Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource PanelText}">
 <UserControl.Resources>
  <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PanelSurface" Color="#F3F6F8"/>
  <SolidColorBrush x:Key="PanelText" Color="#182B38"/>
  <SolidColorBrush x:Key="PanelMuted" Color="#506475"/>
  <SolidColorBrush x:Key="PanelBorder" Color="#D6E0E6"/>
  <SolidColorBrush x:Key="PanelAccent" Color="#126853"/>
  <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PanelDanger" Color="#B42318"/>
  <SolidColorBrush x:Key="NoticeInfoBackground" Color="#EAF3FB"/>
  <SolidColorBrush x:Key="NoticeInfoBorder" Color="#9CC3EA"/>
  <SolidColorBrush x:Key="NoticeWarningBackground" Color="#FFF7E0"/>
  <SolidColorBrush x:Key="NoticeWarningBorder" Color="#E2BC5A"/>
  <SolidColorBrush x:Key="NoticeSuccessBackground" Color="#ECFDF3"/>
  <SolidColorBrush x:Key="NoticeSuccessBorder" Color="#75E0A7"/>
  <SolidColorBrush x:Key="NoticeDangerBackground" Color="#FEF3F2"/>
  <SolidColorBrush x:Key="NoticeDangerBorder" Color="#FDA29B"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,0,8,8"/>
   <Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="{DynamicResource PanelSurface}"/>
   <Setter Property="Foreground" Value="{DynamicResource PanelText}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource PanelMuted}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
  <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
   <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="SelectableInfo" TargetType="TextBox">
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource PanelText}"/>
   <Setter Property="Padding" Value="0"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Cursor" Value="IBeam"/>
  </Style>
  <Style x:Key="SelectableCaption" TargetType="TextBox" BasedOn="{StaticResource SelectableInfo}">
   <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource PanelMuted}"/>
  </Style>
  <Style x:Key="SelectableSection" TargetType="TextBox" BasedOn="{StaticResource SelectableCaption}">
   <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="LineIcon" TargetType="Path">
   <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Stretch" Value="Uniform"/>
   <Setter Property="Fill" Value="Transparent"/><Setter Property="Stroke" Value="{DynamicResource PanelText}"/>
   <Setter Property="StrokeThickness" Value="1.8"/><Setter Property="StrokeLineJoin" Value="Round"/>
   <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
  </Style>
  <Style x:Key="SquareButton" TargetType="Button">
   <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="5,4"/><Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Background" Value="{DynamicResource PanelBackground}"/><Setter Property="Foreground" Value="{DynamicResource PanelText}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" CornerRadius="0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PanelMuted}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PanelAccent}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Main button: accent colours; «En vivo» (UI-8 #26) looks pressed: dark inset border, no hand cursor, click ignored. -->
  <Style x:Key="SyncMainButton" TargetType="Button" BasedOn="{StaticResource SquareButton}">
   <Setter Property="Background" Value="{DynamicResource PanelAccent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource PanelAccent}"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsLive,Mode=OneWay}" Value="True">
    <Setter Property="BorderBrush" Value="{DynamicResource PanelText}"/><Setter Property="BorderThickness" Value="3,3,1,1"/><Setter Property="Cursor" Value="Arrow"/>
   </DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="SquareIconButton" TargetType="Button" BasedOn="{StaticResource SquareButton}">
   <Setter Property="Width" Value="36"/><Setter Property="MinWidth" Value="36"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8"/>
  </Style>
  <Style x:Key="CollapsibleToggle" TargetType="ToggleButton">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,1" CornerRadius="0">
     <ContentPresenter Margin="0,11" HorizontalAlignment="Stretch"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelSurface}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PanelAccent}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="0,2,0,2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="18">
   <Grid Margin="0,1,0,19">
    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Path Grid.Column="0" Style="{StaticResource LineIcon}" Width="21" Height="21" VerticalAlignment="Center" Margin="0,0,3,0"
      Data="M20,11 A8,8 0 0 0 5,7 M4,4 L4,9 L9,9 M4,13 A8,8 0 0 0 19,17 M20,20 L20,15 L15,15"/>
    <TextBox Grid.Column="1" Margin="6,0,0,0" Text="CENTRO DE CMCOORDINATOR" Style="{StaticResource SelectableInfo}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="Centro de Cmcoordinator"/>
   </Grid>
   <Grid Margin="0,0,0,17">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
     <TextBox Text="NOMBRE DEL MODELO" Style="{StaticResource SelectableSection}" Margin="0,0,0,4"/>
     <TextBox Text="{Binding DocumentTitle,Mode=OneWay}" Style="{StaticResource SelectableInfo}" FontSize="17" FontWeight="SemiBold" TextWrapping="NoWrap" ToolTip="{Binding DocumentTitle}" AutomationProperties.Name="{Binding DocumentTitle}"/>
     <TextBox Text="{Binding RevitState,Mode=OneWay}" Style="{StaticResource SelectableCaption}" Margin="0,3,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    <Ellipse Grid.Column="1" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{Binding SyncIndicatorBrush,Mode=OneWay}"
      ToolTip="{Binding SyncIndicatorLabel,Mode=OneWay}" AutomationProperties.Name="{Binding SyncIndicatorLabel,Mode=OneWay}"/>
   </Grid>
   <TextBox Text="RUTA DE CONEXIÓN" Style="{StaticResource SelectableSection}" Margin="0,0,0,10"/>
   <Grid Margin="0,0,0,18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" HorizontalAlignment="Stretch">
     <Path Style="{StaticResource LineIcon}" HorizontalAlignment="Center" Data="M3,4 L21,4 L21,17 L3,17 Z M8,21 L16,21 M12,17 L12,21"/>
     <TextBox Text="Revit" Style="{StaticResource SelectableInfo}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="NoWrap" Margin="0,5,0,2"/>
     <TextBox Text="Origen" Style="{StaticResource SelectableCaption}" TextAlignment="Center"/>
    </StackPanel>
    <Path Grid.Column="1" Style="{StaticResource LineIcon}" Width="13" Height="13" VerticalAlignment="Center" Stroke="{DynamicResource PanelMuted}" Data="M3,12 L21,12 M15,6 L21,12 L15,18"/>
    <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
     <Path Style="{StaticResource LineIcon}" HorizontalAlignment="Center" Data="M3,7 L3,20 L21,20 L21,8 L11,8 L9,5 L3,5 Z M8,12 L8,17 M12,11 L12,17 M16,13 L16,17"/>
     <TextBox Text="{Binding ProjectName,Mode=OneWay}" Style="{StaticResource SelectableInfo}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="NoWrap" ToolTip="{Binding ProjectName}" Margin="0,5,0,2"/>
     <TextBox Text="Proyecto CDE" Style="{StaticResource SelectableCaption}" TextAlignment="Center"/>
    </StackPanel>
    <Path Grid.Column="3" Style="{StaticResource LineIcon}" Width="13" Height="13" VerticalAlignment="Center" Stroke="{DynamicResource PanelMuted}" Data="M3,12 L21,12 M15,6 L21,12 L15,18"/>
    <StackPanel Grid.Column="4" HorizontalAlignment="Stretch">
     <Path Style="{StaticResource LineIcon}" HorizontalAlignment="Center" Data="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z M3,7 L12,12 L21,7 M12,12 L12,22"/>
     <TextBox Text="{Binding DestinationName,Mode=OneWay}" Style="{StaticResource SelectableInfo}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="NoWrap" ToolTip="{Binding DestinationName}" Margin="0,5,0,2"/>
     <TextBox Text="Modelo destino" Style="{StaticResource SelectableCaption}" TextAlignment="Center"/>
    </StackPanel>
   </Grid>
   <Grid Visibility="{Binding GroupVisibility,Mode=OneWay}" Margin="0,-6,0,14" AutomationProperties.Name="Grupo en el modelo" AutomationProperties.HelpText="{Binding GroupHint,Mode=OneWay}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Path Grid.Column="0" Style="{StaticResource LineIcon}" Width="15" Height="15" Margin="0,1,8,0" VerticalAlignment="Top"
      Data="M12,12 A4,4 0 1 0 12,4 A4,4 0 1 0 12,12 M4,21 C4,16.5 7.5,14.5 12,14.5 C16.5,14.5 20,16.5 20,21"/>
    <StackPanel Grid.Column="1">
     <!-- UI-8 #27: who is connected and the group («Francis Vin · Administración»). -->
     <TextBlock FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
      <Run Text="{Binding IdentityName,Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · " Foreground="{DynamicResource PanelMuted}"/><Run Text="{Binding GroupLabel,Mode=OneWay}"/>
     </TextBlock>
     <TextBox Text="{Binding GroupHint,Mode=OneWay}" Style="{StaticResource SelectableCaption}" Margin="0,1,0,0"/>
    </StackPanel>
   </Grid>
   <ToggleButton x:Name="ConnectionToggle" Style="{StaticResource CollapsibleToggle}" IsChecked="False" AutomationProperties.Name="Conexión con el CDE">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Path Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center" Data="M8,4 L16,12 L8,20">
      <Path.Style><Style TargetType="Path" BasedOn="{StaticResource LineIcon}">
       <Style.Triggers><DataTrigger Binding="{Binding IsChecked,ElementName=ConnectionToggle}" Value="True"><Setter Property="Data" Value="M4,8 L12,16 L20,8"/></DataTrigger></Style.Triggers>
      </Style></Path.Style>
     </Path>
     <TextBlock Grid.Column="1" Text="Conexión con el CDE" ToolTip="Conexión con el CDE" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
      <Ellipse Width="7" Height="7" Fill="{Binding ConnectionStateBrush,Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,5,0"/>
      <TextBlock Text="{Binding ConnectionState,Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="NoWrap" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
    </Grid>
   </ToggleButton>
   <StackPanel Visibility="{Binding IsChecked,ElementName=ConnectionToggle,Converter={StaticResource BooleanVisibility}}" Margin="0,13,0,12">
    <TextBox Text="Enlace de conexión" Style="{StaticResource SelectableSection}" Margin="0,0,0,5"/>
    <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Background="{DynamicResource PanelSurface}" Margin="0,0,0,11">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
      <TextBox x:Name="CdeLink" Grid.Column="0" TextChanged="ConnectionChanged" MinHeight="34" Padding="7,5" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource PanelText}" AutomationProperties.Name="Enlace de conexión CDE"/>
      <Button Grid.Column="1" Style="{StaticResource SquareIconButton}" Click="CopyLinkClick" ToolTip="Copiar enlace completo" AutomationProperties.Name="Copiar enlace de conexión">
       <Path Style="{StaticResource LineIcon}" Data="M8,8 L20,8 L20,21 L8,21 Z M4,16 L4,4 L16,4 L16,8"/>
      </Button>
     </Grid>
    </Border>
    <TextBox Text="Token de acceso" Style="{StaticResource SelectableSection}" Margin="0,0,0,5"/>
    <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Background="{DynamicResource PanelSurface}" Margin="0,0,0,10">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
      <PasswordBox x:Name="CdeToken" Grid.Column="0" PasswordChanged="ConnectionChanged" MinHeight="34" Padding="7,5" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource PanelText}" AutomationProperties.Name="Token de acceso CDE"/>
      <TextBox x:Name="VisibleToken" Grid.Column="0" Visibility="Collapsed" TextChanged="VisibleTokenChanged" MinHeight="34" Padding="7,5" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource PanelText}" AutomationProperties.Name="Token de acceso visible"/>
      <Button x:Name="TokenRevealButton" Grid.Column="1" Style="{StaticResource SquareIconButton}" Click="ToggleTokenClick" ToolTip="Mostrar token" AutomationProperties.Name="Mostrar token">
       <Grid>
        <Path x:Name="EyeIcon" Style="{StaticResource LineIcon}" Data="M2,12 C6,4 18,4 22,12 C18,20 6,20 2,12 Z M9,12 A3,3 0 1 0 15,12 A3,3 0 1 0 9,12"/>
        <Path x:Name="EyeOffIcon" Style="{StaticResource LineIcon}" Visibility="Collapsed" Data="M2,2 L22,22 M3,10 C7,4 17,4 21,10 M3,14 C7,20 17,20 21,14 M9,12 A3,3 0 0 0 12,15"/>
       </Grid>
      </Button>
      <Button Grid.Column="2" Style="{StaticResource SquareIconButton}" Click="CopyTokenClick" ToolTip="Copiar token" AutomationProperties.Name="Copiar token de acceso">
       <Path Style="{StaticResource LineIcon}" Data="M8,8 L20,8 L20,21 L8,21 Z M4,16 L4,4 L16,4 L16,8"/>
      </Button>
     </Grid>
    </Border>
    <TextBox x:Name="CopyFeedback" Style="{StaticResource SelectableCaption}" Visibility="Collapsed" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
    <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button x:Name="TestConnectionButton" Grid.Column="0" Style="{StaticResource SquareButton}" Click="TestConnectionClick" AutomationProperties.Name="Probar conexión">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Path Grid.Column="0" Style="{StaticResource LineIcon}" Margin="0,0,6,0" Data="M12,2 L20,6 L20,12 C20,17 17,20 12,22 C7,20 4,17 4,12 L4,6 Z M9,12 L11,14 L15,10"/>
       <TextBlock x:Name="TestConnectionLabel" Grid.Column="1" Text="Probar conexión" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
     </Button>
     <Button x:Name="ConnectCdeButton" Grid.Column="2" Style="{StaticResource SquareButton}" Background="{DynamicResource PanelAccent}" Foreground="{DynamicResource AccentText}" BorderBrush="{DynamicResource PanelAccent}" Click="ConnectCdeClick" IsEnabled="False" AutomationProperties.Name="Conectar con el CDE">
      <StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource AccentText}" StrokeThickness="1.8" Fill="Transparent" Margin="0,0,6,0" Data="M12,2 L12,7 M8,3 L8,7 M7,7 L13,7 L13,11 C13,14 11,15 8,15 C5,15 3,13 3,11 L3,7 Z M8,15 L8,22 M17,8 L21,8 M17,12 L21,12 M17,8 L17,12"/><TextBlock Text="Conectar" VerticalAlignment="Center"/></StackPanel>
     </Button>
    </Grid>
    <TextBox x:Name="ConnectionResult" Text="Pega el enlace y token del proyecto. La prueba no envía el modelo." Style="{StaticResource SelectableCaption}" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
   <Border Visibility="{Binding NoticeVisibility,Mode=OneWay}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,14,0,0"
     AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding NoticeTitle,Mode=OneWay}">
    <Border.Style><Style TargetType="Border">
     <Setter Property="Background" Value="{DynamicResource NoticeInfoBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource NoticeInfoBorder}"/>
     <Style.Triggers><DataTrigger Binding="{Binding NoticeKind,Mode=OneWay}" Value="Warning">
      <Setter Property="Background" Value="{DynamicResource NoticeWarningBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource NoticeWarningBorder}"/>
     </DataTrigger><DataTrigger Binding="{Binding NoticeKind,Mode=OneWay}" Value="Success">
      <Setter Property="Background" Value="{DynamicResource NoticeSuccessBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource NoticeSuccessBorder}"/>
     </DataTrigger><DataTrigger Binding="{Binding NoticeKind,Mode=OneWay}" Value="Danger">
      <Setter Property="Background" Value="{DynamicResource NoticeDangerBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource NoticeDangerBorder}"/>
     </DataTrigger></Style.Triggers>
    </Style></Border.Style>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Path Grid.Column="0" Width="15" Height="15" Margin="0,1,8,0" VerticalAlignment="Top">
      <Path.Style><Style TargetType="Path" BasedOn="{StaticResource LineIcon}">
       <Setter Property="Data" Value="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,11 L12,17 M12,7 L12,7.5"/>
       <Style.Triggers><DataTrigger Binding="{Binding NoticeKind,Mode=OneWay}" Value="Warning">
        <Setter Property="Data" Value="M12,3 L22,20 L2,20 Z M12,9 L12,14 M12,16.5 L12,17"/>
       </DataTrigger><DataTrigger Binding="{Binding NoticeTitle,Mode=OneWay}" Value="Solo lectura en este modelo">
        <Setter Property="Data" Value="M6,10 L18,10 L18,21 L6,21 Z M8.5,10 L8.5,7 A3.5,3.5 0 0 1 15.5,7 L15.5,10 M12,14 L12,17"/>
       </DataTrigger><DataTrigger Binding="{Binding NoticeKind,Mode=OneWay}" Value="Success">
        <Setter Property="Data" Value="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M7.5,12 L10.5,15 L16.5,9"/>
       </DataTrigger><DataTrigger Binding="{Binding NoticeKind,Mode=OneWay}" Value="Danger">
        <Setter Property="Data" Value="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M8.5,8.5 L15.5,15.5 M15.5,8.5 L8.5,15.5"/>
       </DataTrigger></Style.Triggers>
      </Style></Path.Style>
     </Path>
     <StackPanel Grid.Column="1">
      <TextBox Text="{Binding NoticeTitle,Mode=OneWay}" Style="{StaticResource SelectableInfo}" FontSize="12" FontWeight="SemiBold"/>
      <TextBox Text="{Binding NoticeText,Mode=OneWay}" Style="{StaticResource SelectableCaption}" Margin="0,2,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Margin="0,14,0,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" Style="{StaticResource SyncMainButton}" Tag="sync" Click="ActionClick" IsEnabled="{Binding SyncButtonEnabled,Mode=OneWay}"
      ToolTip="{Binding SyncHint,Mode=OneWay}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding SyncLabel,Mode=OneWay}" AutomationProperties.HelpText="{Binding SyncHint,Mode=OneWay}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource AccentText}" StrokeThickness="1.8" Margin="0,0,5,0" VerticalAlignment="Center">
       <Path.Style><Style TargetType="Path"><Setter Property="Fill" Value="Transparent"/><Setter Property="Data" Value="M20,11 A8,8 0 0 0 5,7 M4,4 L4,9 L9,9 M4,13 A8,8 0 0 0 19,17 M20,20 L20,15 L15,15"/>
        <Style.Triggers><DataTrigger Binding="{Binding Access.ReadOnly,Mode=OneWay}" Value="True"><Setter Property="Data" Value="M6,10 L18,10 L18,21 L6,21 Z M8.5,10 L8.5,7 A3.5,3.5 0 0 1 15.5,7 L15.5,10"/></DataTrigger>
         <DataTrigger Binding="{Binding IsLive,Mode=OneWay}" Value="True"><Setter Property="Data" Value="M12,7 A5,5 0 1 0 12,17 A5,5 0 1 0 12,7 Z"/><Setter Property="Fill" Value="{DynamicResource AccentText}"/></DataTrigger></Style.Triggers>
       </Style></Path.Style>
      </Path>
      <TextBlock Grid.Column="1" Text="{Binding SyncLabel,Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" VerticalAlignment="Center"/>
     </Grid>
    </Button>
    <Button Grid.Column="2" Style="{StaticResource SquareButton}" Tag="pause" Click="ActionClick" IsEnabled="{Binding CanPause,Mode=OneWay}" AutomationProperties.Name="{Binding PauseLabel,Mode=OneWay}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource PanelText}" StrokeThickness="1.8" Fill="Transparent" Margin="0,0,5,0" VerticalAlignment="Center">
       <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M7,4 L7,20 M17,4 L17,20"/>
        <Style.Triggers><DataTrigger Binding="{Binding ShowPlayIcon,Mode=OneWay}" Value="True"><Setter Property="Data" Value="M6,4 L20,12 L6,20 Z"/></DataTrigger></Style.Triggers>
       </Style></Path.Style>
      </Path>
      <TextBlock Grid.Column="1" Text="{Binding PauseLabel,Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" VerticalAlignment="Center"/>
     </Grid>
    </Button>
   </Grid>
   <Button Style="{StaticResource SquareButton}" Tag="replace" Click="ReplaceClick" Margin="0,0,0,14" HorizontalAlignment="Stretch"
     Visibility="{Binding ReplaceVisibility,Mode=OneWay}" IsEnabled="{Binding CanReplace,Mode=OneWay}" Foreground="{DynamicResource PanelDanger}"
     ToolTip="{Binding ReplaceHint,Mode=OneWay}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Reemplazar modelo" AutomationProperties.HelpText="{Binding ReplaceHint,Mode=OneWay}">
    <StackPanel Orientation="Horizontal">
     <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource PanelDanger}" StrokeThickness="1.8" Fill="Transparent" Margin="0,0,6,0" VerticalAlignment="Center"
       StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,7 L20,7 M4,7 L7,4 M4,7 L7,10 M20,17 L4,17 M20,17 L17,14 M20,17 L17,20"/>
     <TextBlock Text="Reemplazar modelo…" FontSize="12" VerticalAlignment="Center"/>
    </StackPanel>
   </Button>
   <Button Style="{StaticResource SquareButton}" Tag="restore" Click="RestoreClick" Margin="0,-6,0,14" HorizontalAlignment="Stretch"
     Visibility="{Binding RestoreVisibility,Mode=OneWay}" IsEnabled="{Binding CanRestore,Mode=OneWay}"
     ToolTip="Devuelve el modelo del CDE a como estaba antes del último reemplazo" AutomationProperties.Name="Restaurar modelo anterior">
    <StackPanel Orientation="Horizontal">
     <Path Style="{StaticResource LineIcon}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Data="M4,4 L4,9 L9,9 M4.6,9 A8,8 0 1 1 4,13"/>
     <TextBlock Text="Restaurar modelo anterior…" FontSize="12" VerticalAlignment="Center"/>
    </StackPanel>
   </Button>
   <Border Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
    <StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding TransferBrush,Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox Grid.Column="1" Text="{Binding TransferTitle,Mode=OneWay}" Style="{StaticResource SelectableInfo}" FontWeight="SemiBold" TextWrapping="NoWrap" AutomationProperties.LiveSetting="Polite"/>
      <TextBox Grid.Column="2" Text="{Binding TransferPercentLabel,Mode=OneWay}" Style="{StaticResource SelectableInfo}" FontWeight="SemiBold" Margin="8,0,0,0"/>
     </Grid>
     <TextBox Text="{Binding TransferDetail,Mode=OneWay}" Style="{StaticResource SelectableCaption}" Margin="0,6,0,0"/>
     <ProgressBar Value="{Binding TransferPercent,Mode=OneWay}" IsIndeterminate="{Binding TransferIndeterminate,Mode=OneWay}" Maximum="100" Height="6" Margin="0,10,0,0"
       Foreground="{Binding TransferBrush,Mode=OneWay}" Visibility="{Binding TransferProgressVisibility,Mode=OneWay}" AutomationProperties.Name="{Binding BlockLabel,Mode=OneWay}">
      <ProgressBar.Template><ControlTemplate TargetType="ProgressBar">
       <Grid Background="{DynamicResource PanelBorder}" ClipToBounds="True">
        <Border Background="{TemplateBinding Foreground}" RenderTransformOrigin="0,0.5" CornerRadius="3">
         <Border.RenderTransform><ScaleTransform ScaleX="{Binding TransferFraction,Mode=OneWay}"/></Border.RenderTransform>
        </Border>
       </Grid>
      </ControlTemplate></ProgressBar.Template>
     </ProgressBar>
     <TextBox Text="{Binding BlockLabel,Mode=OneWay}" Style="{StaticResource SelectableCaption}" Margin="0,6,0,0"/>
    </StackPanel>
   </Border>
   <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Path Grid.Column="0" Style="{StaticResource LineIcon}" Width="19" Height="19" Margin="0,2,9,0" VerticalAlignment="Top"
      Data="M12,3 L21,8 L12,13 L3,8 Z M3,12 L12,17 L21,12 M3,16 L12,21 L21,16"/>
    <StackPanel Grid.Column="1"><TextBox Text="Elementos capturados" Style="{StaticResource SelectableInfo}" FontWeight="SemiBold" TextWrapping="NoWrap"/>
     <TextBox Text="Última captura del modelo" Style="{StaticResource SelectableCaption}" Margin="0,2,0,0"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="8,0,0,0" HorizontalAlignment="Right">
     <TextBox Text="{Binding CapturedCount,Mode=OneWay}" Style="{StaticResource SelectableInfo}" FontSize="20" FontWeight="SemiBold" TextAlignment="Right" AutomationProperties.LiveSetting="Polite"/>
     <TextBox Text="elementos" Style="{StaticResource SelectableCaption}" TextAlignment="Right"/>
    </StackPanel>
   </Grid>
   <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Path Grid.Column="0" Style="{StaticResource LineIcon}" Width="19" Height="19" Margin="0,2,9,0" VerticalAlignment="Top"
      Data="M3,3 L21,3 L21,21 L3,21 Z M3,10 L13,10 L13,21 M13,15 L21,15"/>
    <StackPanel Grid.Column="1">
     <TextBox Text="Vistas 2D" Style="{StaticResource SelectableInfo}" FontWeight="SemiBold" TextWrapping="NoWrap"/>
     <TextBox Text="{Binding DrawingStatus,Mode=OneWay}" Style="{StaticResource SelectableCaption}" Margin="0,2,0,8" AutomationProperties.LiveSetting="Polite"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button Grid.Column="0" Style="{StaticResource SquareButton}" Tag="drawings" Click="ActionClick" IsEnabled="{Binding CanChooseDrawings,Mode=OneWay}" AutomationProperties.Name="Elegir vistas 2D">
       <TextBlock Text="Elegir vistas 2D" TextWrapping="Wrap" TextAlignment="Center"/>
      </Button>
      <Button Grid.Column="2" Style="{StaticResource SquareButton}" Tag="drawingsFolder" Click="ActionClick" IsEnabled="{Binding CanChooseDrawings,Mode=OneWay}" AutomationProperties.Name="Abrir carpeta de vistas 2D">
       <TextBlock Text="Abrir carpeta" TextWrapping="Wrap" TextAlignment="Center"/>
      </Button>
     </Grid>
    </StackPanel>
   </Grid>
    <local:SyncHistoryView x:Name="HistoryView" Margin="0,12,0,0"/>
   <Expander Header="Actividad y diagnóstico" Margin="0,20,0,12" Foreground="{DynamicResource PanelText}">
    <StackPanel>
     <TextBox Text="{Binding Activity,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="240"
       VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top"
       Background="{DynamicResource PanelSurface}" Foreground="{DynamicResource PanelText}" FontSize="12" Margin="0,10,0,10"/>
    </StackPanel>
   </Expander>
   <Grid Margin="0,0,0,8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
     <Button Tag="export" Click="ActionClick" Style="{StaticResource SquareButton}" HorizontalAlignment="Stretch" AutomationProperties.Name="Descargar diagnóstico ZIP">
      <TextBlock Text="Descargar diagnóstico" TextWrapping="Wrap" TextAlignment="Center"/>
     </Button>
     <TextBlock Text="Guarda los logs en un ZIP para compartirlos si ocurre un problema." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <Button Tag="reset" Click="ActionClick" Style="{StaticResource SquareButton}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanRestartCapture,Mode=OneWay}" AutomationProperties.Name="Reiniciar captura completa de Revit">
      <TextBlock Text="Reiniciar captura" TextWrapping="Wrap" TextAlignment="Center"/>
     </Button>
     <TextBlock Text="Vuelve a leer el modelo completo y prepara una nueva sincronización." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
    </StackPanel>
   </Grid>
   <Border x:Name="UpdateCard" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="4"
           Background="{DynamicResource PanelSurface}" Padding="12" Margin="0,10,0,16">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
      <TextBlock Text="Cmcoordinator" FontWeight="SemiBold" Foreground="{DynamicResource PanelText}"/>
      <TextBlock x:Name="PluginVersionText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
      <TextBlock x:Name="UpdateAvailabilityText" Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Busca actualizaciones estables"/>
     </StackPanel>
     <Button x:Name="PanelUpdateButton" Grid.Column="1" Click="PanelUpdateClick" Margin="0" VerticalAlignment="Center"
             AutomationProperties.Name="Actualizar Cmcoordinator desde GitHub">
      <StackPanel Orientation="Horizontal">
       <Path Style="{StaticResource LineIcon}" Margin="0,0,6,0" Data="M12,3 L12,12 L17,12 M20,12 A8,8 0 1 1 12,4 M12,1 L12,5 L16,5"/>
       <TextBlock Text="Actualizar" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
    </Grid>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
