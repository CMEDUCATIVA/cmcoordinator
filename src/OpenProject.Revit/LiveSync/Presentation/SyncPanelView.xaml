<UserControl x:Class="OpenProject.Revit.LiveSync.Presentation.SyncPanelView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="280" FontFamily="Segoe UI" FontSize="14"
 Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource PanelText}">
 <UserControl.Resources>
  <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PanelSurface" Color="#F3F6F8"/>
  <SolidColorBrush x:Key="PanelText" Color="#182B38"/>
  <SolidColorBrush x:Key="PanelMuted" Color="#506475"/>
  <SolidColorBrush x:Key="PanelBorder" Color="#D6E0E6"/>
  <SolidColorBrush x:Key="PanelAccent" Color="#126853"/>
  <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,0,8,8"/>
   <Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="{DynamicResource PanelSurface}"/>
   <Setter Property="Foreground" Value="{DynamicResource PanelText}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource PanelMuted}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="18">
   <TextBlock Text="Cmcoordinator · Revit en vivo" Style="{StaticResource Caption}"/>
   <TextBlock Text="Centro de sincronización" FontSize="19" FontWeight="Medium" Margin="0,5,0,16" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding CdeSession,Mode=OneWay}" Style="{StaticResource Caption}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding Model,Mode=OneWay}" FontWeight="Medium" TextWrapping="Wrap"/>
   <TextBlock x:Name="DestinationText" Text="Vista 3D → visor local · protocolo 2" Style="{StaticResource Caption}" Margin="0,4,0,12"/>
   <Expander Header="Conectar con el CDE" Margin="0,0,0,12" Foreground="{DynamicResource PanelText}">
    <StackPanel Margin="0,10,0,0">
     <TextBlock Text="Enlace generado en BCF → Conectar a Revit" Style="{StaticResource Caption}"/>
     <TextBox x:Name="CdeLink" TextChanged="ConnectionChanged" MinHeight="34" Margin="0,5,0,10" Padding="7" TextWrapping="Wrap" AutomationProperties.Name="Enlace de conexión CDE"
       Background="{DynamicResource PanelSurface}" Foreground="{DynamicResource PanelText}" BorderBrush="{DynamicResource PanelBorder}"/>
     <TextBlock Text="Token de conexión" Style="{StaticResource Caption}"/>
     <PasswordBox x:Name="CdeToken" PasswordChanged="ConnectionChanged" MinHeight="34" Margin="0,5,0,10" Padding="7" AutomationProperties.Name="Token de conexión CDE"
       Background="{DynamicResource PanelSurface}" Foreground="{DynamicResource PanelText}" BorderBrush="{DynamicResource PanelBorder}"/>
     <WrapPanel><Button x:Name="TestConnectionButton" Content="Probar conexión" Click="TestConnectionClick"/>
      <Button x:Name="ConnectCdeButton" Content="Conectar" Click="ConnectCdeClick" IsEnabled="False"/>
      <Button Content="Usar visor local" Click="UseLocalClick"/></WrapPanel>
     <TextBlock x:Name="ConnectionResult" Text="Pega el enlace y token del proyecto. La prueba no envía el modelo." Style="{StaticResource Caption}" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
   </Expander>
   <WrapPanel>
    <Button Content="↻ Sincronizar" Tag="sync" Click="ActionClick" Background="{DynamicResource PanelAccent}" Foreground="{DynamicResource AccentText}"/>
    <Button Content="{Binding PauseLabel,Mode=OneWay}" Tag="pause" Click="ActionClick"/>
    <Button Content="■ Parar" Tag="stop" Click="ActionClick"/>
   </WrapPanel>
   <Border Background="{DynamicResource PanelSurface}" CornerRadius="9" Padding="14" Margin="0,8,0,12">
    <StackPanel>
     <TextBlock Text="{Binding Status.Stage,Mode=OneWay}" FontWeight="Medium" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="{Binding Status.Detail,Mode=OneWay}" Style="{StaticResource Caption}" Margin="0,6,0,10"/>
     <ProgressBar Value="{Binding Status.Percent,Mode=OneWay}" Maximum="100" Height="6" Foreground="{DynamicResource PanelAccent}" AutomationProperties.Name="{Binding BlockLabel,Mode=OneWay}"/>
     <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding BlockLabel,Mode=OneWay}" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <TextBlock Text="{Binding Capture,Mode=OneWay}" Style="{StaticResource Caption}" Margin="0,0,0,14"/>
   <WrapPanel><Button Content="Reintentar" Tag="retry" Click="ActionClick"/><Button Content="Abrir visor" Tag="viewer" Click="ActionClick"/></WrapPanel>
   <TextBlock Text="Cola e historial" FontWeight="Medium" Margin="0,12,0,8"/>
   <TextBlock Text="{Binding PendingLabel,Mode=OneWay}" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
   <ItemsControl ItemsSource="{Binding Status.Jobs,Mode=OneWay}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,9">
      <StackPanel>
       <DockPanel><TextBlock Text="{Binding State,Mode=OneWay}" FontWeight="Medium"/><TextBlock Text="{Binding Time,Mode=OneWay}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></DockPanel>
       <TextBlock Text="{Binding Detail,Mode=OneWay}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
       <TextBlock Text="{Binding Id,Mode=OneWay}" Style="{StaticResource Caption}" FontSize="11"/>
      </StackPanel>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <TextBlock Text="Última revisión guardada" Style="{StaticResource Caption}" Margin="0,18,0,2"/><TextBlock Text="{Binding StoredRevision,Mode=OneWay}"/>
   <TextBlock Text="Última revisión presentada en visor" Style="{StaticResource Caption}" Margin="0,10,0,2"/><TextBlock Text="{Binding DisplayedRevision,Mode=OneWay}"/>
   <Expander Header="Actividad y diagnóstico" Margin="0,20,0,12" Foreground="{DynamicResource PanelText}">
    <StackPanel>
     <TextBox Text="{Binding Activity,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240" VerticalScrollBarVisibility="Auto"
       Background="{DynamicResource PanelSurface}" Foreground="{DynamicResource PanelText}" FontSize="12" Margin="0,10,0,10"/>
     <Button Content="Exportar diagnóstico" Tag="export" Click="ActionClick" HorizontalAlignment="Left"/>
    </StackPanel>
   </Expander>
   <Button Content="Reconstruir base completa" Tag="reset" Click="ActionClick" HorizontalAlignment="Left"/>
   <TextBlock Text="Cola local persistente. Puedes cerrar este panel y seguir modelando. Los logs permanecen en este equipo." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
