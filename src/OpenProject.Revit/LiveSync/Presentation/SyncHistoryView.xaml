<UserControl x:Class="OpenProject.Revit.LiveSync.Presentation.SyncHistoryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI" FontSize="12" Background="White" Foreground="#182B38">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
  <Style x:Key="FlatAction" TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D6E0E6"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7,5"/>
   <Setter Property="MinHeight" Value="30"/><Setter Property="Cursor" Value="Hand"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#126853"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="FilterAction" TargetType="Button" BasedOn="{StaticResource FlatAction}">
   <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="EntryToggle" TargetType="ToggleButton">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="#D6E0E6" BorderThickness="0">
     <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F3F6F8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderThickness" Value="0,0,0,2"/><Setter TargetName="Row" Property="BorderBrush" Value="#126853"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SelectableText" TargetType="TextBox">
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#182B38"/>
   <Setter Property="Padding" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Cursor" Value="IBeam"/><Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
 </UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Button x:Name="HeaderButton" Click="ToggleClick" Background="Transparent" BorderThickness="0" Padding="0,5" HorizontalContentAlignment="Stretch" Cursor="Hand" AutomationProperties.Name="Expandir o contraer cola e historial">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Path x:Name="Chevron" Width="14" Height="14" Stroke="#182B38" StrokeThickness="2" Stretch="Uniform" Data="M4,8 L12,16 L20,8" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="Cola e historial" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Border Grid.Column="2" Background="#EEF2F4" BorderBrush="#D6E0E6" BorderThickness="1" CornerRadius="9" Margin="7,0,0,0" Padding="5,1" ToolTip="Revisiones conservadas en la cola local (máximo 100)">
     <TextBlock x:Name="CountBadge" Text="0" FontSize="11"/>
    </Border>
    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
     <Ellipse x:Name="QueueDot" Width="7" Height="7" Fill="#24C331" Margin="0,0,5,0" VerticalAlignment="Center"/>
     <TextBlock x:Name="QueueState" Text="Al día" Foreground="#506475" VerticalAlignment="Center"/>
    </StackPanel>
   </Grid>
  </Button>
  <StackPanel x:Name="ContentArea" Grid.Row="1" HorizontalAlignment="Stretch">
   <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="AllButton" Grid.Column="0" Content="Todos" Tag="Todos" Click="FilterClick" Style="{StaticResource FilterAction}"/>
    <Button x:Name="WaitingButton" Grid.Column="1" Content="En espera" Tag="En espera" Click="FilterClick" Style="{StaticResource FilterAction}"/>
    <Button x:Name="ProcessedButton" Grid.Column="2" Content="Procesados" Tag="Procesados" Click="FilterClick" Style="{StaticResource FilterAction}"/>
   </Grid>
   <Grid MinHeight="200" HorizontalAlignment="Stretch">
   <ScrollViewer x:Name="ListScroll" MaxHeight="290" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
    <ItemsControl x:Name="Events">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="#D6E0E6" BorderThickness="0,0,0,1" Padding="0,5">
       <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ToggleButton Grid.RowSpan="2" Grid.Column="0" Tag="HistoryEntry" Style="{StaticResource EntryToggle}" IsChecked="{Binding IsExpanded,Mode=TwoWay}" AutomationProperties.Name="Expandir detalles de revisión" ToolTip="Expandir o contraer detalle">
           <Path Width="13" Height="13" Stroke="#506475" StrokeThickness="1.7" Fill="Transparent" Stretch="Uniform" VerticalAlignment="Center">
           <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M8,4 L16,12 L8,20"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Data" Value="M4,8 L12,16 L20,8"/></DataTrigger></Style.Triggers>
           </Style></Path.Style>
           </Path>
          </ToggleButton>
          <Grid Grid.Row="0" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Border Grid.Column="0" Width="16" Height="16" Background="{Binding IconBackground}" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip="{Binding State}">
            <Path Data="{Binding IconGeometry}" Width="10" Height="10" Fill="{Binding IconForeground}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
           </Border>
           <TextBox Grid.Column="1" Text="{Binding State,Mode=OneWay}" Style="{StaticResource SelectableText}" FontWeight="SemiBold" TextWrapping="NoWrap" ToolTip="{Binding State}" Margin="2,0,5,0"/>
          </Grid>
          <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Clock,Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="#506475" FontSize="11" TextAlignment="Right" TextWrapping="NoWrap"/>
          <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ShortDetail,Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="#506475" TextWrapping="NoWrap" ToolTip="{Binding Detail}" Margin="0,2,0,0"/>
         </Grid>
        <StackPanel Margin="18,6,0,6" Visibility="{Binding IsExpanded,Converter={StaticResource BooleanVisibility}}">
        <TextBlock Text="Identificador de revisión" Foreground="#506475" FontSize="11"/>
        <TextBox Text="{Binding Id,Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="11" AutomationProperties.Name="Identificador de revisión"/>
        <TextBox Text="{Binding Detail,Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,6,0,2"/>
        <TextBox Text="{Binding DateAndTime,Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="#506475"/>
        </StackPanel>
       </StackPanel>
      </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <TextBox x:Name="EmptyText" Text="Cargando historial…" Style="{StaticResource SelectableText}" Foreground="#506475" Margin="0,12" VerticalAlignment="Top"/>
   </Grid>
   <Button x:Name="MoreButton" Content="Mostrar más (5)" Visibility="Collapsed" Click="MoreClick" Style="{StaticResource FlatAction}" HorizontalAlignment="Center" Margin="0,8,0,3"/>
  </StackPanel>
 </Grid>
</UserControl>
