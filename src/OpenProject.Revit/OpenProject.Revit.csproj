<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Revit2027 Condition="$(Configuration.Contains('2027'))">true</Revit2027>
    <Revit2026 Condition="$(Configuration.Contains('2026'))">true</Revit2026>
    <Revit2025 Condition="$(Configuration.Contains('2025'))">true</Revit2025>
    <Revit2024 Condition="$(Configuration.Contains('2024'))">true</Revit2024>
    <Revit2023 Condition="$(Configuration.Contains('2023'))">true</Revit2023>
    <Revit2022 Condition="$(Configuration.Contains('2022'))">true</Revit2022>
    <Revit2021 Condition="$(Configuration.Contains('2021'))">true</Revit2021>
    <Revit2020 Condition="$(Configuration.Contains('2020'))">true</Revit2020>
    <Revit2019 Condition="$(Configuration.Contains('2019'))">true</Revit2019>
    <RevitVersion Condition="$(Configuration.Contains('2027'))">2027</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2026'))">2026</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2025'))">2025</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2024'))">2024</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2023'))">2023</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2022'))">2022</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2021'))">2021</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2020'))">2020</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2019'))">2019</RevitVersion>
    <!-- Fallback to 2022 if no specific version is detected -->
    <RevitVersion Condition="'$(RevitVersion)' == ''">2022</RevitVersion>
    <LangVersion>latest</LangVersion>
    <Version>2026.10.2</Version>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework Condition="'$(Revit2027)' == true">net10.0-windows7.0</TargetFramework>
    <TargetFramework Condition="'$(Revit2025)' == true or '$(Revit2026)' == true">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(Revit2021)' == true or '$(Revit2022)' == true or '$(Revit2023)' == true or '$(Revit2024)' == true">net48</TargetFramework>
    <TargetFramework Condition="'$(Revit2019)' == true or '$(Revit2020)' == true">net472</TargetFramework>
    <!-- Fallback to net48 if no specific framework is set -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <UseWPF>true</UseWPF>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableAppDataDeployment Condition="'$(EnableAppDataDeployment)' == ''">false</EnableAppDataDeployment>
    <Configurations>Debug;Release;Release-2019;Debug-2019;Release-2020;Debug-2020;Release-2021;Debug-2021;Release-2022;Debug-2022;Release-2023;Debug-2023;Release-2024;Debug-2024;Release-2025;Debug-2025;Release-2026;Debug-2026;Release-2027;Debug-2027</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants Condition="'$(Revit2027)' == true">$(DefineConstants);Version2027</DefineConstants>
    <DefineConstants Condition="'$(Revit2026)' == true">$(DefineConstants);Version2026</DefineConstants>
    <DefineConstants Condition="'$(Revit2025)' == true">$(DefineConstants);Version2025</DefineConstants>
    <DefineConstants Condition="'$(Revit2024)' == true">$(DefineConstants);Version2024</DefineConstants>
    <DefineConstants Condition="'$(Revit2023)' == true">$(DefineConstants);Version2023</DefineConstants>
    <DefineConstants Condition="'$(Revit2022)' == true">$(DefineConstants);Version2022</DefineConstants>
    <DefineConstants Condition="'$(Revit2021)' == true">$(DefineConstants);Version2021</DefineConstants>
    <DefineConstants Condition="'$(Revit2020)' == true">$(DefineConstants);Version2020</DefineConstants>
    <DefineConstants Condition="'$(Revit2019)' == true">$(DefineConstants);Version2019</DefineConstants>
    <!-- API generations (as in pyRevit): ForgeTypeId units from 2021, ForgeTypeId groups and specs from 2022. -->
    <DefineConstants Condition="'$(RevitVersion)' &gt;= 2021">$(DefineConstants);REVIT2021_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= 2022">$(DefineConstants);REVIT2022_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release-2019|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug-2019|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release-2020|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug-2020|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release-2021|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug-2021|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release-2022|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug-2022|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release-2023|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug-2023|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release-2024|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug-2024|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release-2025|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug-2025|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release-2026|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug-2026|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release-2027|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug-2027|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\tools\updater\apply-update.ps1" Link="Updater\apply-update.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\local-live-viewer\server.mjs" Link="LiveViewer\server.mjs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\local-live-viewer\lib\*.mjs" Link="LiveViewer\lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\local-live-viewer\ifc\*.py" Link="LiveViewer\ifc\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\local-live-viewer\public\*" Link="LiveViewer\public\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\local-live-viewer\node_modules\three\build\three.module.js;..\..\tools\local-live-viewer\node_modules\three\build\three.core.js"
      Link="LiveViewer\node_modules\three\build\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\local-live-viewer\node_modules\three\examples\jsm\controls\OrbitControls.js"
      Link="LiveViewer\node_modules\three\examples\jsm\controls\OrbitControls.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\local-live-viewer\node_modules\three\LICENSE" Link="LiveViewer\node_modules\three\LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgSQLitePCLRaw_lib_e_sqlite3)\runtimes\win-x64\native\e_sqlite3.dll"
      Link="e_sqlite3.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.18" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.10" GeneratePathProperty="true" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
    <!--<PackageReference Condition="'$(Revit2022)' == true" Include="Revit_All_Main_Versions_API_x64" Version="2022.0.0" />
    <PackageReference Condition="'$(Revit2021)' == true" Include="Revit_All_Main_Versions_API_x64" Version="2021.0.0" />
    <PackageReference Condition="'$(Revit2020)' == true" Include="Revit_All_Main_Versions_API_x64" Version="2020.0.1" />
    <PackageReference Condition="'$(Revit2019)' == true" Include="Revit_All_Main_Versions_API_x64" Version="2019.0.1" />-->
    <PackageReference Include="ZetaIpc" Version="1.0.0.11" />
    <PackageReference Condition="'$(Revit2026)' == true or '$(Revit2027)' == true" Include="Xbim.Essentials" Version="6.1.605" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenProject.Shared\OpenProject.Shared.csproj">
      <Private>True</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48' or '$(TargetFramework)' == 'net472'">
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48' or '$(TargetFramework)' == 'net472'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Cmcoordinator.addin">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyBrowserApp" AfterTargets="Build" Condition="$(Configuration.Contains('Debug')) And '$(BuildingInsideVisualStudio)' == 'true' And '$(EnableAppDataDeployment)' == 'true'">
    <ItemGroup>
      <SourceDLLs Include="$(TargetDir)**\*.*" />
      <SourceManifest Include="$(TargetDir)*.addin" />
      <OpenProjectBrowser Include="$(SolutionDir)\src\OpenProject.Browser\bin\x64\Debug\net48\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(SourceDLLs)" DestinationFolder="$(AppData)\Autodesk\REVIT\Addins\$(RevitVersion)\$(ProjectName)\%(RecursiveDir)" />
    <Copy SourceFiles="@(SourceManifest)" DestinationFolder="$(AppData)\Autodesk\REVIT\Addins\$(RevitVersion)\" />
    <Copy SourceFiles="@(OpenProjectBrowser)" DestinationFolder="$(AppData)\Autodesk\REVIT\Addins\$(RevitVersion)\$(ProjectName)\%(RecursiveDir)" />
  </Target>
</Project>
