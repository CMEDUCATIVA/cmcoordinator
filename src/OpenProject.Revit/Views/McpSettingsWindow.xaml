<Window x:Class="OpenProject.Revit.Views.McpSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualizaciones"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <!-- Only «Actualizaciones» is shown (2026-11-08). Conexión, Visibilidad and Agente IA left the window,
       but what they saved stays in the settings file: the Centro CDE pins and the IA bridge keep reading it. -->
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel x:Name="UpdatesPanel" Grid.Row="0">
      <TextBlock Text="Actualizar Cmcoordinator" FontWeight="Bold" Margin="0,0,0,12"/>
      <TextBlock x:Name="InstalledVersionText" Margin="0,0,0,8"/>
      <TextBlock Text="Origen: GitHub · CMEDUCATIVA/cmcoordinator" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="Descarga la última publicación estable y verifica el instalador. Se instalará después de cerrar Revit; Windows puede solicitar permisos de administrador."
                 TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,16"/>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="UpdateButton" Content="Actualizar desde GitHub" Padding="12,5" Click="OnUpdateClick"/>
        <Button x:Name="CancelUpdateButton" Content="Cancelar descarga" Padding="12,5" Margin="8,0,0,0"
                Visibility="Collapsed" Click="OnCancelUpdateClick"/>
      </StackPanel>
      <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,16,0,0"
                 AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Cerrar" Width="90" Click="OnCloseClick"/>
    </StackPanel>
  </Grid>
</Window>
