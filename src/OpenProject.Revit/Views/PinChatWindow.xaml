<Window x:Class="OpenProject.Revit.Views.PinChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comentarios"
        Height="360"
        Width="320"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip">
  <Border Margin="8" BorderThickness="1" BorderBrush="#C8C8C8" CornerRadius="6" Background="White">
    <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Messages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,6" Padding="6" Background="#F2F2F2" CornerRadius="4">
              <StackPanel>
                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontSize="10" Foreground="#666"/>
                <TextBox Text="{Binding Text}"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap">
                  <TextBox.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Copiar" Command="ApplicationCommands.Copy"/>
                    </ContextMenu>
                  </TextBox.ContextMenu>
                </TextBox>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="1" Margin="0,6,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0"
              Width="26"
              Height="26"
              Margin="0,0,6,0"
              Background="Transparent"
              BorderThickness="0"
              Focusable="False"
              ToolTip="Emojis"
              Click="OnEmojiClick">
        <Button.ContextMenu>
          <ContextMenu FontFamily="Segoe UI Emoji">
            <MenuItem Header="😀" Tag="😀" Click="OnEmojiItemClick"/>
            <MenuItem Header="😄" Tag="😄" Click="OnEmojiItemClick"/>
            <MenuItem Header="😉" Tag="😉" Click="OnEmojiItemClick"/>
            <MenuItem Header="😍" Tag="😍" Click="OnEmojiItemClick"/>
            <MenuItem Header="👍" Tag="👍" Click="OnEmojiItemClick"/>
            <MenuItem Header="🙏" Tag="🙏" Click="OnEmojiItemClick"/>
            <MenuItem Header="✅" Tag="✅" Click="OnEmojiItemClick"/>
            <MenuItem Header="⚠️" Tag="⚠️" Click="OnEmojiItemClick"/>
          </ContextMenu>
        </Button.ContextMenu>
        <Viewbox Width="16" Height="16">
          <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Data="M8,15A7,7 0 1 1 8,1A7,7 0 0 1 8,15 M8,16A8,8 0 1 0 8,0A8,8 0 0 0 8,16 M4.285,9.567A0.5,0.5 0 0 1 4.968,9.75A3.5,3.5 0 0 0 8,11.5A3.5,3.5 0 0 0 11.032,9.75A0.5,0.5 0 1 1 11.898,10.25A4.5,4.5 0 0 1 8,12.5A4.5,4.5 0 0 1 4.102,10.25A0.5,0.5 0 0 1 4.285,9.567 M7,6.5C7,7.328 6.552,8 6,8C5.448,8 5,7.328 5,6.5C5,5.672 5.448,5 6,5C6.552,5 7,5.672 7,6.5 M11,6.5C11,7.328 10.552,8 10,8C9.448,8 9,7.328 9,6.5C9,5.672 9.448,5 10,5C10.552,5 11,5.672 11,6.5"/>
        </Viewbox>
      </Button>

      <TextBox Grid.Column="1"
               x:Name="MessageInput"
               MinHeight="26"
               MaxHeight="140"
               Text="{Binding CurrentMessage, UpdateSourceTrigger=PropertyChanged}"
               VerticalContentAlignment="Center"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Disabled"
               PreviewKeyDown="OnMessageInputKeyDown"
               TextChanged="OnMessageInputTextChanged"/>

      <Button Grid.Column="2"
              Width="30"
              Height="26"
              Margin="6,0,0,0"
              Command="{Binding SendCommand}"
              Background="Transparent"
              BorderThickness="0"
              Focusable="False"
              ToolTip="Enviar comentario">
        <Viewbox Width="16" Height="16">
          <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Data="M16,8A8,8 0 1 1 0,8A8,8 0 0 1 16,8 M6.79,5.093A0.5,0.5 0 0 0 6,5.5V10.5A0.5,0.5 0 0 0 6.79,10.907L10.29,8.407A0.5,0.5 0 0 0 10.29,7.593Z"/>
        </Viewbox>
      </Button>
    </Grid>
    </Grid>
  </Border>
</Window>
