<UserControl x:Class="OpenProject.Revit.Views.PinsPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <Grid Background="#F7F7F7">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="8,8,8,0">
      <StackPanel Orientation="Horizontal">
        <Button Padding="2"
                Margin="0,0,8,0"
                Command="{Binding RefreshCommand}"
                Background="Transparent"
                BorderThickness="0"
                Focusable="False">
          <Button.Style>
            <Style TargetType="Button">
              <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                    </Setter.Value>
                  </Setter>
                  <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Viewbox Width="16" Height="16">
            <Canvas Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
              <Canvas.RenderTransform>
                <RotateTransform x:Name="RefreshIconRotate"/>
              </Canvas.RenderTransform>
              <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Data="M8 3 A5 5 0 1 0 12.546 5.914 A0.5 0.5 0 0 1 13.454 5.497 A6 6 0 1 1 8 2 Z"/>
              <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Data="M8 4.466 V0.534 A0.25 0.25 0 0 1 8.41 0.342 L10.77 2.308 C10.89 2.408 10.89 2.592 10.77 2.692 L8.41 4.658 A0.25 0.25 0 0 1 8 4.466 Z"/>
            </Canvas>
          </Viewbox>
        </Button>
        <ToggleButton Width="28"
                      Height="26"
                      Margin="0,0,8,0"
                      Padding="2"
                      ToolTip="Colorear selección por estado"
                      IsChecked="{Binding StatusHighlightEnabled, Mode=TwoWay}">
          <ToggleButton.Style>
            <Style TargetType="ToggleButton">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Foreground" Value="Black"/>
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6">
                      <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter Property="Background" Value="#6BFF8A"/>
                  <Setter Property="Effect">
                    <Setter.Value>
                      <DropShadowEffect Color="#00FF5A" BlurRadius="22" ShadowDepth="0" Opacity="0.95"/>
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </Style.Triggers>
            </Style>
          </ToggleButton.Style>
          <Viewbox Width="16" Height="16">
            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                  Data="M8,15A7,7 0 1 1 8,1A7,7 0 0 1 8,15 M8,16A8,8 0 1 0 8,0A8,8 0 0 0 8,16 M7.002,11A1,1 0 1 1 9.002,11A1,1 0 0 1 7.002,11 M7.1,4.995A0.905,0.905 0 1 1 8.9,4.995L8.55,8.502A0.552,0.552 0 0 1 7.45,8.502Z"/>
          </Viewbox>
        </ToggleButton>
      </StackPanel>

      <Grid Margin="0,6,0,0">
        <ComboBox x:Name="ProjectComboBox"
                  Margin="0"
                  MinHeight="34"
                  MaxDropDownHeight="320"
                  ItemsSource="{Binding Projects}"
                  SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                  IsEditable="False"
                  IsTextSearchEnabled="False"
                  PreviewMouseLeftButtonDown="OnProjectComboBoxPreviewMouseLeftButtonDown"
                  DropDownOpened="OnProjectDropDownOpened"
                  DropDownClosed="OnProjectDropDownClosed"
                  SelectionChanged="OnProjectSelectionChanged"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemContainerStyle>
            <Style TargetType="ComboBoxItem">
              <Setter Property="MinHeight" Value="28"/>
              <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
          </ComboBox.ItemContainerStyle>
          <ComboBox.Template>
            <ControlTemplate TargetType="ComboBox">
              <Grid>
                <Border x:Name="OuterBorder"
                        Background="White"
                        BorderBrush="#ADADAD"
                        BorderThickness="1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                      <ContentPresenter x:Name="SelectionContent"
                                        Margin="8,0,8,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                      <TextBlock Text="Elige un proyecto"
                                 Margin="8,0,6,0"
                                 Foreground="#8A8A8A"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>

                      <Grid Margin="2,2,2,2">
                        <Grid.Style>
                          <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="28"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="#8A8A8A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

                        <TextBox x:Name="PART_ProjectSearchTextBox"
                                 Grid.Column="1"
                                 VerticalContentAlignment="Center"
                                 Padding="0,3,6,3"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Text="{Binding ProjectSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="OnSearchTextBoxPreviewKeyDown">
                          <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchProjectsCommand}"/>
                          </TextBox.InputBindings>
                        </TextBox>

                        <TextBlock Grid.Column="1"
                                   Text="Buscar"
                                   Margin="0,0,6,0"
                                   Foreground="#8A8A8A"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=PART_ProjectSearchTextBox}" Value="">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=PART_ProjectSearchTextBox}" Value="{x:Null}">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                    </Grid>

                    <ToggleButton Grid.Column="1"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  ClickMode="Press">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                          <Border Background="Transparent" BorderThickness="0">
                            <Path Width="8"
                                  Height="4"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Fill="#555555"
                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                          </Border>
                        </ControlTemplate>
                      </ToggleButton.Template>
                    </ToggleButton>
                  </Grid>
                </Border>

                <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">
                  <Border Margin="0,1,0,0"
                          MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}"
                          Background="White"
                          BorderBrush="#ADADAD"
                          BorderThickness="1">
                    <ScrollViewer CanContentScroll="True">
                      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>

              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="OuterBorder" Property="Opacity" Value="0.6"/>
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                  <Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </ComboBox.Template>
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
    </StackPanel>

    <DataGrid x:Name="PinsGrid"
              Grid.Row="1"
              Margin="8"
              ItemsSource="{Binding Items}"
              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
              AutoGenerateColumns="False"
              HeadersVisibility="Column"
              GridLinesVisibility="All"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              IsReadOnly="True"
              RowHeaderWidth="0"
              CanUserReorderColumns="True"
              FrozenColumnCount="1"
              ColumnReordered="OnColumnReordered"
              LayoutUpdated="OnGridLayoutUpdated"
              SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTemplateColumn x:Name="AccionesColumn" Header="Acciones" Width="Auto" MinWidth="110" CanUserReorder="False">
          <DataGridTemplateColumn.CellStyle>
            <Style TargetType="DataGridCell">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderBrush" Value="{x:Null}"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </DataGridTemplateColumn.CellStyle>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                <Button Padding="2"
                        Margin="0,0,4,0"
                        Command="{Binding ViewCommand}"
                        ToolTip="Ver seleccionado"
                        Background="Transparent"
                        BorderThickness="0"
                        Focusable="False">
                  <Viewbox Width="14" Height="14">
                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M16,8C16,8 13,2.5 8,2.5C3,2.5 0,8 0,8C0,8 3,13.5 8,13.5C13,13.5 16,8 16,8 M1.173,8C1.173,8 1.802,7.096 2.833,5.957C4.12,4.668 5.88,3.5 8,3.5C10.12,3.5 11.879,4.668 13.168,5.957C13.832,6.621 14.273,7.281 14.828,8C14.828,8 14.464,8.569 14.438,8.611C14.104,9.091 13.608,9.731 12.973,10.366C11.879,11.332 10.119,12.5 8,12.5C5.88,12.5 4.12,11.332 2.833,10.043C2.199,9.409 1.703,8.77 1.367,8.288C1.299,8.19 1.233,8.092 1.173,8 M8,5.5A2.5,2.5 0 1 0 8,10.5A2.5,2.5 0 0 0 8,5.5 M4.5,8A3.5,3.5 0 1 1 11.5,8A3.5,3.5 0 0 1 4.5,8Z"/>
                  </Viewbox>
                </Button>
                <Button Padding="2"
                        Command="{Binding GoCommand}"
                        ToolTip="Abrir el Work Package en el CDE"
                        Background="Transparent"
                        BorderThickness="0"
                        Focusable="False">
                  <Viewbox Width="14" Height="14">
                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M6.364,13.5A0.5,0.5 0 0 0 6.864,14H13.5A1.5,1.5 0 0 0 15,12.5V2.5A1.5,1.5 0 0 0 13.5,1H3.5A1.5,1.5 0 0 0 2,2.5V9.136A0.5,0.5 0 0 0 3,9.136V2.5A0.5,0.5 0 0 1 3.5,2H13.5A0.5,0.5 0 0 1 14,2.5V12.5A0.5,0.5 0 0 1 13.5,13H6.864A0.5,0.5 0 0 0 6.364,13.5 M11,5.5A0.5,0.5 0 0 0 10.5,5H5.5A0.5,0.5 0 0 0 5.5,6H9.293L1.146,14.146A0.5,0.5 0 0 0 1.854,14.854L10,6.707V10.5A0.5,0.5 0 0 0 11,10.5Z"/>
                  </Viewbox>
                </Button>
                <Button Padding="2"
                        Margin="4,0,0,0"
                        Command="{Binding ChatCommand}"
                        ToolTip="Comentarios"
                        Background="Transparent"
                        BorderThickness="0"
                        Focusable="False">
                  <Viewbox Width="14" Height="14">
                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M14,1A1,1 0 0 1 15,2V10A1,1 0 0 1 14,11H4.414A2,2 0 0 0 3,11.586L1,13.586V2A1,1 0 0 1 2,1ZM2,0A2,2 0 0 0 0,2V14.793A0.5,0.5 0 0 0 0.854,15.146L3.707,12.293A1,1 0 0 1 4.414,12H14A2,2 0 0 0 16,10V2A2,2 0 0 0 14,0Z M5,6A1,1 0 1 1 3,6A1,1 0 0 1 5,6 M9,6A1,1 0 1 1 7,6A1,1 0 0 1 9,6 M13,6A1,1 0 1 1 11,6A1,1 0 0 1 13,6"/>
                  </Viewbox>
                </Button>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn x:Name="IdColumn" Header="ID" Binding="{Binding WorkPackageId}" Width="70"/>
        <DataGridTextColumn x:Name="NombreColumn" Header="Nombre" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn x:Name="UrlColumn" Header="URL" Binding="{Binding Url}" Width="200"/>
        <DataGridTextColumn x:Name="TipoColumn" Header="Tipo" Binding="{Binding Type}" Width="100"/>
        <DataGridTextColumn x:Name="PrioridadColumn" Header="Prioridad" Binding="{Binding Priority}" Width="100"/>
        <DataGridTemplateColumn x:Name="EstadoColumn" Header="Estado" Width="160">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Background="{Binding StatusColor}" CornerRadius="3" Padding="4,2" Margin="2,0">
                <TextBlock Text="{Binding Status}" Foreground="Black" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn x:Name="AsignadoColumn" Header="Asignado" Binding="{Binding Assignee}" Width="130"/>
        <DataGridTextColumn x:Name="ResponsableColumn" Header="Responsable" Binding="{Binding Responsible}" Width="130"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
